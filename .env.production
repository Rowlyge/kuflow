# ==========================================================
# HTTP Server
# ==========================================================

SERVER_PORT=8080

SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=60s

# ==========================================================
# PostgreSQL
# ==========================================================

POSTGRES_DB=proxydb
POSTGRES_USER=proxy
POSTGRES_PASSWORD=q7J8mL4Xz9Kp2Vb8Tn6Rw3

DATABASE_URL=postgres://proxy:q7J8mL4Xz9Kp2Vb8Tn6Rw3@postgres:5432/proxydb?sslmode=disable

# ==========================================================
# Authentication
# ==========================================================

AUTH_API_KEY_HEADER=X-API-Key

# ==========================================================
# Reverse Proxy
# ==========================================================

PROXY_BALANCER=round_robin

# Пока оставим тестовые upstream
# Потом заменим на реальные
PROXY_UPSTREAMS=http://upstream1:8081,http://upstream2:8082,http://upstream3:8083

PROXY_DIAL_TIMEOUT=5s
PROXY_RESPONSE_HEADER_TIMEOUT=10s
PROXY_FLUSH_INTERVAL=100ms

# ==========================================================
# Health Checker
# ==========================================================

HEALTH_ENABLED=true
HEALTH_INTERVAL=5s
HEALTH_TIMEOUT=2s
HEALTH_PATH=/health

HEALTH_FAILURE_THRESHOLD=3
HEALTH_SUCCESS_THRESHOLD=2

# ==========================================================
# Telemetry
# ==========================================================

TELEMETRY_ENABLED=true
TELEMETRY_ASYNC=false

# ==========================================================
# Auth Cache
# ==========================================================

AUTH_CACHE_REFRESH_INTERVAL=10s

# ==========================================================
# Rate Limiter
# ==========================================================

RATE_LIMIT_CAPACITY=100
RATE_LIMIT_REFILL_TOKENS=100
RATE_LIMIT_REFILL_INTERVAL=1m

# ==========================================================
# Connection Limiter
# ==========================================================

CONNECTION_LIMIT_MAX=100