# ==========================================================
# KuFlow Configuration
# ==========================================================

# ==========================================================
# HTTP Server
# ==========================================================

SERVER_PORT=8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=60s

# ==========================================================
# PostgreSQL
# ==========================================================

DATABASE_URL=postgres://proxy:proxy@localhost:5432/proxydb?sslmode=disable

# ==========================================================
# Authentication
# ==========================================================

AUTH_API_KEY_HEADER=X-API-Key

# ==========================================================
# Reverse Proxy
# ==========================================================

# Comma-separated list of upstream servers.
PROXY_UPSTREAMS=http://localhost:8081,http://localhost:8082,http://localhost:8083

# Available:
#   round_robin
#   random (future)
#   least_connections (future)
PROXY_BALANCER=round_robin

# Timeout for establishing a TCP connection.
PROXY_DIAL_TIMEOUT=5s

# Maximum time to wait for response headers.
PROXY_RESPONSE_HEADER_TIMEOUT=10s

# Flush interval for streaming responses.
PROXY_FLUSH_INTERVAL=100ms

# ==========================================================
# Health Checker
# ==========================================================

HEALTH_ENABLED=true
HEALTH_INTERVAL=5s
HEALTH_TIMEOUT=2s
HEALTH_PATH=/health

HEALTH_FAILURE_THRESHOLD=3
HEALTH_SUCCESS_THRESHOLD=2

# ==========================================================
# Telemetry
# ==========================================================

TELEMETRY_ENABLED=true
TELEMETRY_ASYNC=false

# ==========================================================
# Auth Cache
# ==========================================================

AUTH_CACHE_REFRESH_INTERVAL=10s

# ==========================================================
# Rate Limiter
# ==========================================================

RATE_LIMIT_CAPACITY=100
RATE_LIMIT_REFILL_TOKENS=100
RATE_LIMIT_REFILL_INTERVAL=1m

# ==========================================================
# Connection Limiter
# ==========================================================

CONNECTION_LIMIT_MAX=100